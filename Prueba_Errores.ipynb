    "#  MAPA COROPLÉTICO: INCIDENCIA DE VIOLENCIA POR REGIÓN\n",
    "import geopandas as gpd\n",
    "shapefile_local = \"regiones.json\"\n",
    "\n",
    "gdf_regiones = gpd.read_file(shapefile_local)\n",
    "print(\"Columnas shapefile:\", gdf_regiones.columns.tolist())\n",
    "display(gdf_regiones.head())\n",
    "\n",
    "gdf_regiones = gdf_regiones.reset_index(drop=True).copy()\n",
    "gdf_regiones['Codigo_region'] = gdf_regiones.index + 1\n",
    "df_bienestar['Codigo_region'] = df_bienestar['Codigo_region'].astype(int)\n",
    "\n",
    "\n",
    "# Calcular la incidencia de violencia por región\n",
    "incidencia = (\n",
    "    df_bienestar.groupby('Codigo_region')['Sufrió_Alguna_Violencia']\n",
    "    .mean()\n",
    "    .reset_index()\n",
    ")\n",
    "incidencia['Incidencia_%'] = incidencia['Sufrió_Alguna_Violencia'] * 100\n",
    "\n",
    "print(\"\\nIncidencia por región:\")\n",
    "print(incidencia.head())\n",
    "\n",
    "# Unir los datos\n",
    "gdf_mapa = gdf_regiones.merge(incidencia, on='Codigo_region', how='left')\n",
    "gdf_mapa['Incidencia_%'] = gdf_mapa['Incidencia_%'].fillna(0)\n",
    "\n",
    "# Gráfcia\n",
    "fig, ax = plt.subplots(1, 1, figsize=(10, 8))\n",
    "gdf_mapa.plot(\n",
    "    column='Incidencia_%',\n",
    "    ax=ax,\n",
    "    cmap='PuBuGn',\n",
    "    legend=True,\n",
    "    legend_kwds={'label': 'Porcentaje de estudiantes que reportaron violencia (%)'},\n",
    "    edgecolor='black',\n",
    "    linewidth=0.4\n",
    ")\n",
    "\n",
    "ax.set_title('Incidencia de violencia por región (%)', fontsize=14, weight='bold')\n",
    "ax.axis('off')\n",
    "\n",
    "plt.show()"
   ]
  }
 ],
