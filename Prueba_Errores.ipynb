    "fig, axes = plt.subplots(1, 3, figsize=(14, 10))\n",
    "for ax, df, titulo in zip(axes, dataframes, titulos):\n",
    "    conteo = df['Sexo'].value_counts()\n",
    "    colores = [\n",
    "        'pink' if sexo == 'Mujer' else 'blue'\n",
    "        for sexo in conteo.index\n",
    "    ]\n",
    "    ax.pie(\n",
    "        conteo,\n",
    "        labels = conteo.index,\n",
    "        autopct = '%1.1f%%',\n",
    "        startangle = 90,\n",
    "        colors = colores,\n",
    "        wedgeprops = {'edgecolor': 'white'}\n",
    "    )\n",
    "    ax.set_title(titulo, fontsize=18, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.subplots_adjust(wspace=0.3)\n",
    "plt.show()\n"
