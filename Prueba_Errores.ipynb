    "df_bienestar = df.copy()\n",
    "\n",
    "# Definición columnas por tipo de violencia y la columna de bienestar\n",
    "columnas_violencia_verbal = ['PB_1_1']\n",
    "columnas_violencia_fisica = ['PA_5_1', 'PA_6_1', 'PB_2_1', 'PC_1_1', 'PC_2_1', 'PC_5_1']\n",
    "columnas_violencia_sexual = ['PD_3_1', 'PD_4_1', 'PD_5_1', 'PD_6_1', 'PD_7_1']\n",
    "columnas_bienestar = ['PG_1', 'PG_2', 'PG_3', 'PG_4', 'PG_6', 'PG_8', 'PG_9', 'PG_10']\n",
    "\n",
    "# Crear indicadores de violencia\n",
    "for tipo, columnas in {\n",
    "    'Sufrió_Verbal': columnas_violencia_verbal,\n",
    "    'Sufrió_Física': columnas_violencia_fisica,\n",
    "    'Sufrió_Sexual': columnas_violencia_sexual\n",
    "}.items():\n",
    "    df_bienestar[tipo] = df_bienestar[columnas].apply(lambda row: 1 if (row == 1).any() else 0, axis=1)\n",
    "df_bienestar['Sufrió_Alguna_Violencia'] = df_bienestar[['Sufrió_Verbal', 'Sufrió_Física', 'Sufrió_Sexual']].max(axis=1)\n",
    "\n",
    "# Promedio de las respuestas PG_1 a PG_10 (entre más alto → mayor bienestar)\n",
    "df_bienestar['Indice_Bienestar'] = df_bienestar[columnas_bienestar].mean(axis=1)\n",
    "\n",
    "\n",
    "# GRÁFICA BIENESTAR GENERAL SEGÚN EXPERIENCIA DE VIOLENCIA\n",
    "plt.figure(figsize=(9, 6))\n",
    "sns.boxplot(\n",
    "    data=df_bienestar,\n",
    "    x='Sufrió_Alguna_Violencia',\n",
    "    y='Indice_Bienestar',\n",
    "    hue='Sufrió_Alguna_Violencia',\n",
    "    palette='pastel',\n",
    "    legend=False\n",
    ")\n",
    "plt.title('Bienestar emocional promedio según experiencia de violencia')\n",
    "plt.xlabel('¿Sufrió alguna violencia? (0 = No, 1 = Sí)')\n",
    "plt.ylabel('Índice de bienestar emocional (promedio PG)')\n",
    "plt.xticks([0, 1], ['No', 'Sí'])\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# GRÁFICA BIENESTAR POR TIPO DE VIOLENCIA\n",
    "df_melt = df_bienestar.melt(\n",
    "    id_vars='Indice_Bienestar',\n",
    "    value_vars=['Sufrió_Verbal', 'Sufrió_Física', 'Sufrió_Sexual'],\n",
    "    var_name='Tipo_de_Violencia',\n",
    "    value_name='Sufrió'\n",
    ")\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.boxplot(\n",
    "    data=df_melt,\n",
    "    x='Tipo_de_Violencia',\n",
    "    y='Indice_Bienestar',\n",
    "    hue='Sufrió',\n",
    "    palette='pastel'\n",
    ")\n",
    "plt.title('Comparación del bienestar emocional según tipo de violencia')\n",
    "plt.xlabel('Tipo de violencia')\n",
    "plt.ylabel('Índice de bienestar emocional (promedio PG)')\n",
    "plt.legend(title='¿Sufrió este tipo? (0 = No, 1 = Sí)')\n",
    "plt.tight_layout()\n",
    "plt.show()"
