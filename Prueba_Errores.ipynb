    "df = pd.read_csv('Data-Encuestas.csv')\n",
    "\n",
    "# Columnas de tipos de violencia\n",
    "columnas_violencia_verbal = ['PB_1_1']\n",
    "columnas_violencia_fisica = ['PA_5_1', 'PA_6_1', 'PB_2_1', 'PC_1_1', 'PC_2_1', 'PC_5_1']\n",
    "columnas_violencia_sexual = ['PD_3_1', 'PD_4_1', 'PD_5_1', 'PD_6_1', 'PD_7_1']\n",
    "\n",
    "año1 = 2017\n",
    "año2 = 2023\n",
    "\n",
    "# Función para calcular los porcentajes del tipo de violencia\n",
    "def calcular_porcentajes(df, año, columnas, tipo):\n",
    "    df_año = df[df['Año'] == año]\n",
    "    # Se calcula la media de todos los valores '1' dentro de las columnas del tipo\n",
    "    valores = []\n",
    "    for col in columnas:\n",
    "        if col in df_año.columns:\n",
    "            valores.append((df_año[col] == 1).mean())\n",
    "    if len(valores) > 0:\n",
    "        return {\n",
    "            'Año': año,\n",
    "            'Tipo_de_Violencia': tipo,\n",
    "            'Porcentaje': sum(valores) / len(valores) * 100\n",
    "        }\n",
    "    else:\n",
    "        return None\n",
    "resultados = []\n",
    "\n",
    "for tipo, columnas in [('Violencia verbal/emocional', columnas_violencia_verbal),\n",
    "                        ('Violencia física', columnas_violencia_fisica),\n",
    "                        ('Violencia sexual', columnas_violencia_sexual)]:\n",
    "    for año in [año1, año2]:\n",
    "        res = calcular_porcentajes(df, año, columnas, tipo)\n",
    "        if res:\n",
    "            resultados.append(res)\n",
    "\n",
    "df_comparacion = pd.DataFrame(resultados)\n",
    "\n",
    "print(\"\\nPorcentajes promedio por tipo de violencia y año:\")\n",
    "print(df_comparacion)\n",
    "\n",
    "# Gráfico\n",
    "palette = {\n",
    "    2017: '#A7C7E7',\n",
    "    2023: '#F7A8B8'\n",
    "}\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.barplot(\n",
    "    data=df_comparacion,\n",
    "    x='Tipo_de_Violencia',\n",
    "    y='Porcentaje',\n",
    "    hue='Año',\n",
    "    palette= palette\n",
    ")\n",
    "plt.title('Comparación de tipos de violencia infantil reportada (2017 vs 2023)')\n",
    "plt.xlabel('Tipo de violencia')\n",
    "plt.ylabel('Porcentaje promedio de estudiantes que reportan haberla sufrido (%)')\n",
    "plt.legend(title='Año de encuesta')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
