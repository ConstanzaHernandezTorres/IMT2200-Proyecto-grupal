    "# Gráfico CORRELACIÓN ENTRE VIOLENCIAS Y BIENESTAR\n",
    "# Seleccionamos las columnas relevantes\n",
    "columnas_corr = [\n",
    "    'Sufrió_Verbal',\n",
    "    'Sufrió_Física',\n",
    "    'Sufrió_Sexual',\n",
    "    'Sufrió_Alguna_Violencia',\n",
    "    'Indice_Bienestar'\n",
    "]\n",
    "# Calcular la matriz de correlación\n",
    "corr_matrix = df_bienestar[columnas_corr].corr(method='spearman')\n",
    "\n",
    "# Crear el mapa de calor\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(\n",
    "    corr_matrix,\n",
    "    annot=True,\n",
    "    fmt=\".2f\",\n",
    "    cmap='PuBuGn',\n",
    "    center=0,\n",
    "    linewidths=0.5,\n",
    "    cbar_kws={'label': 'Correlación (Spearman)'}\n",
    ")\n",
    "plt.title('Mapa de calor: correlación entre tipos de violencia y bienestar emocional')\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
