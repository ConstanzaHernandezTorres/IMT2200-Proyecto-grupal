   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "df = pd.read_csv('Data-Encuestas.csv')\n",
    "\n",
    "# Columnas violencia\n",
    "columnas_violencia_verbal = ['PB_1_1']\n",
    "columnas_violencia_fisica = ['PA_5_1', 'PA_6_1', 'PB_2_1', 'PC_1_1', 'PC_2_1', 'PC_5_1']\n",
    "columnas_violencia_sexual = ['PD_3_1', 'PD_4_1', 'PD_5_1', 'PD_6_1', 'PD_7_1']\n",
    "\n",
    "columnas_vulneraciones = (\n",
    "    columnas_violencia_verbal +\n",
    "    columnas_violencia_fisica +\n",
    "    columnas_violencia_sexual\n",
    ")\n",
    "\n",
    "año1 = 2017\n",
    "año2 = 2023\n",
    "print(df['Año'].value_counts())\n",
    "\n",
    "# Calculo\n",
    "resultados_por_año = []\n",
    "for año in [año1, año2]:\n",
    "    df_año = df[df['Año'] == año]\n",
    "    for col in columnas_vulneraciones:\n",
    "        porcentaje = (df_año[col] == 1).mean() * 100\n",
    "        resultados_por_año.append({\n",
    "            'Año': año,\n",
    "            'Vulneración': col,\n",
    "            'Porcentaje': porcentaje\n",
    "        })\n",
    "df_comparacion = pd.DataFrame(resultados_por_año)\n",
    "\n",
    "print(\"\\nPorcentaje de reportes por vulneración y año:\")\n",
    "print(df_comparacion)\n",
    "\n",
    "# Gráfico\n",
    "palette = {\n",
    "    2017: '#A7C7E7',\n",
    "    2023: '#F7A8B8'}\n",
    "plt.figure(figsize=(14, 7))\n",
    "sns.barplot(data=df_comparacion, x='Vulneración', y='Porcentaje', hue='Año', palette=palette)\n",
    "plt.title('Comparación de vulneraciones reportadas (2017 vs 2023)')\n",
    "plt.xlabel('Código de vulneración')\n",
    "plt.ylabel('Porcentaje de estudiantes (%)')\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.legend(title='Año de Encuesta')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
