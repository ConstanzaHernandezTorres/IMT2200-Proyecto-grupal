    "def clasificar_agresor(row):\n",
    "    if (\n",
    "       (pd.notna(row.get(\"PA_5_4\")) and row[\"PA_5_4\"] in [3,4])  #Esta alternativa indica que sea adolescente, niño o niña.\n",
    "       or (pd.notna(row.get(\"PC_1\")) and row[\"PC_1\"] == 1)  #Esta pregunta especifica que fue agredido por un niño, niña o adolescente.\n",
    "       or (pd.notna(row.get(\"PC_2\")) and row[\"PC_2\"] == 1)  #Esta pregunta especifica que fue agredido por un grupo de niños, niñas o adolescentes.\n",
    "    ): \n",
    "        return \"Pares\"\n",
    "\n",
    "    if (\n",
    "       (pd.notna(row.get(\"PA_6_4\")) and row[\"PA_6_4\"] == 1)  #Esta alternativa indica que fue agredido por alguien cercano con quien vive.\n",
    "       or (pd.notna(row.get(\"PA_7_4\")) and row[\"PA_7_4\"] == 1)  #Esta alternativa indica que fue agredido por alguién cercano con quien vive.\n",
    "       or ((pd.notna(row.get(\"PB_2\")) and row[\"PB_2\"] == 1) and  #Esta pregunta especifica que fue agredido por algún adulto cercano.\n",
    "       (pd.notna(row.get(\"PB_2_4\")) and row[\"PB_2_4\"] == 1))  #Esta alternativa indica que vive con el adulto cercano que lo agredió.\n",
    "    ): \n",
    "        return \"Persona cercana\"\n",
    "\n",
    "    if (pd.notna(row.get(\"PC_5\")) and row[\"PC_5\"] == 1):  #Esta pregunta especifica que fue agredido por una pareja romántica\n",
    "        return \"Pareja romántica\"\n",
    "\n",
    "    if (\n",
    "       (pd.notna(row.get(\"PA_6_4\")) and row[\"PA_6_4\"] == 2) #Esta alternativa indica que fue agredido por alguien cercano, pero con quien no vive.\n",
    "       or (pd.notna(row.get(\"PA_7_4\")) and row[\"PA_7_4\"] == 2)   #Esta alternativa indica que fue agredido por alguien cercano, pero con quien no vive.\n",
    "       or ((pd.notna(row.get(\"PB_2\")) and row[\"PB_2\"] == 1) and   #Esta pregunta especifica que fue agredido por algún adulto cercano.\n",
    "       (pd.notna(row.get(\"PB_2_4\")) and row[\"PB_2_4\"] == 2))  #Esta alternativa indica que no vive con el adulto cercano que lo agredió. \n",
    "    ): \n",
    "        return \"Conocido\"\n",
    "\n",
    "    if (\n",
    "       (pd.notna(row.get(\"PA_6_4\")) and row[\"PA_6_4\"] == 3)  #Esta alternativa indica que fue agredido por un extraño.\n",
    "       or (pd.notna(row.get(\"PA_7_4\")) and row[\"PA_7_4\"] == 3)  #Esta alternativa indica que fue agredido por un extraño.\n",
    "    ): \n",
    "        return \"Extraño\"\n",
    "\n",
    "    return pd.NA\n",
    "\n",
    "df_inicial[\"Tipo_agresor\"] = df_inicial.apply(clasificar_agresor, axis=1)\n",
    "\n",
    "conteos = (df_inicial.groupby([\"Año\", \"Tipo_agresor\"], observed=True).size().reset_index(name=\"Casos\"))\n",
    "\n",
    "# Calcular proporciones dentro de cada año\n",
    "conteos[\"Porcentaje\"] = (conteos.groupby(\"Año\")[\"Casos\"].transform(lambda x: x / x.sum() * 100))\n",
    "proporciones = conteos.copy()\n",
    "\n",
    "colores = ['plum', \"lightgreen\",'lightsalmon','paleturquoise', \"pink\"]\n",
